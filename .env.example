# ============================================================
# FIXORA - VARIABLES DE ENTORNO DE EJEMPLO
# ============================================================
# Copiar este archivo como ".env.local".
#
# Sustituir todos los valores que comienzan con CHANGE_ME.
# Nunca guardar .env.local, contraseñas o secretos en Git.
# ============================================================


# ------------------------------------------------------------
# SITIO Y ORÍGENES PERMITIDOS
# ------------------------------------------------------------

# Desarrollo local:
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Separar varios orígenes mediante comas.
# Ejemplo de producción:
# AUTH_ALLOWED_ORIGINS=https://fixora.com,https://www.fixora.com
AUTH_ALLOWED_ORIGINS=http://localhost:3000


# ------------------------------------------------------------
# SQL SERVER
# ------------------------------------------------------------

SQL_SERVER_HOST=127.0.0.1

# Utilizar una instancia o un puerto, pero nunca ambos.
#
# Ejemplo con SQL Server Express:
SQL_SERVER_INSTANCE=SQLEXPRESS

# Dejar vacío cuando se utiliza SQL_SERVER_INSTANCE.
#
# Para utilizar un puerto fijo:
# SQL_SERVER_INSTANCE=
# SQL_SERVER_PORT=1433
SQL_SERVER_PORT=

SQL_SERVER_DATABASE=Fixora
SQL_SERVER_USER=fixora_app

SQL_SERVER_PASSWORD=CHANGE_ME_WITH_A_REAL_SQL_PASSWORD_OF_AT_LEAST_16_CHARACTERS

# En desarrollo local normalmente:
SQL_SERVER_ENCRYPT=false
SQL_SERVER_TRUST_SERVER_CERTIFICATE=true

# En producción deben revisarse de acuerdo con
# el certificado y la configuración del servidor.

SQL_SERVER_CONNECTION_TIMEOUT_MS=15000
SQL_SERVER_REQUEST_TIMEOUT_MS=15000

SQL_SERVER_POOL_MAX=10
SQL_SERVER_POOL_MIN=0
SQL_SERVER_POOL_IDLE_TIMEOUT_MS=30000


# ------------------------------------------------------------
# SESIONES
# ------------------------------------------------------------

AUTH_SESSION_COOKIE_NAME=fixora_session
AUTH_SESSION_TTL_HOURS=168

# Desarrollo local:
AUTH_SESSION_COOKIE_SECURE=false

# Producción con HTTPS:
# AUTH_SESSION_COOKIE_SECURE=true


# ------------------------------------------------------------
# CÓDIGOS DE VERIFICACIÓN Y RECUPERACIÓN
# ------------------------------------------------------------

AUTH_VERIFICATION_CODE_TTL_MINUTES=10
AUTH_PASSWORD_RESET_CODE_TTL_MINUTES=10
AUTH_CODE_MAX_ATTEMPTS=5


# ------------------------------------------------------------
# SECRETOS DE AUTENTICACIÓN
# ------------------------------------------------------------

# Cada secreto debe:
# - Tener como mínimo 32 caracteres.
# - Ser aleatorio.
# - Ser diferente de los demás.
# - No compartirse ni subirse a Git.

AUTH_CODE_PEPPER=CHANGE_ME_WITH_A_UNIQUE_RANDOM_SECRET_FOR_CODES_OF_AT_LEAST_32_CHARACTERS

AUTH_SESSION_PEPPER=CHANGE_ME_WITH_A_DIFFERENT_RANDOM_SECRET_FOR_SESSIONS_OF_AT_LEAST_32_CHARACTERS

AUTH_RATE_LIMIT_PEPPER=CHANGE_ME_WITH_A_DIFFERENT_RANDOM_SECRET_FOR_RATE_LIMITS_OF_AT_LEAST_32_CHARACTERS

AUTH_PASSWORD_RESET_TOKEN_SECRET=CHANGE_ME_WITH_A_DIFFERENT_RANDOM_SECRET_FOR_RESET_TOKENS_OF_AT_LEAST_32_CHARACTERS


# ------------------------------------------------------------
# ENVÍO DE CORREOS
# ------------------------------------------------------------

# Valores permitidos:
#
# console:
# Muestra el correo en la terminal.
# Solo debe usarse durante el desarrollo.
#
# smtp:
# Envía el correo mediante un servidor SMTP real.

AUTH_EMAIL_MODE=console

AUTH_EMAIL_FROM="Fixora <no-reply@fixora.local>"


# ------------------------------------------------------------
# SMTP
# ------------------------------------------------------------

# Estos valores son necesarios cuando:
# AUTH_EMAIL_MODE=smtp

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Para Gmail con puerto 587:
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true

SMTP_USER=

# En Gmail debe utilizarse una contraseña de aplicación.
# No utilizar la contraseña normal de la cuenta.
SMTP_PASSWORD=

SMTP_CONNECTION_TIMEOUT_MS=15000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=30000