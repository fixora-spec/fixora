# See https://help.github.com/articles/ignoring-files/
# for more information about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# miscellaneous
.DS_Store
Thumbs.db
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*

# The public environment template must be committed.
!.env.example

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# local database and authentication artifacts
*.bak
*.bacpac
*.mdf
*.ldf
*.ndf

# temporary files
*.tmp
*.temp
*.swp
*.swo